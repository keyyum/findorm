# Copy this file to .env and fill in real values. Never commit .env.

PORT=5050
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string, or mongodb://127.0.0.1:27017/findorm for local
MONGO_URI=

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary, for listing photos (FR-05)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limits (per 15 minutes; messages per 10 minutes per user). Optional.
# Set RATE_LIMIT=off to disable them, e.g. when re-running tests/api.test.mjs.
# LOGIN_RATE_LIMIT=10
# REGISTER_RATE_LIMIT=20
# MESSAGE_RATE_LIMIT=30
# RATE_LIMIT=off
